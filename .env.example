# Sentinel AI V1.0 Environment Variables

# API & Server
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./database/sentinel.db

# LLM Config
LLM_PROVIDER=mock  # Options: mock, gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# RAG & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_INDEX_PATH=models/faiss.index

# Machine Learning
THREAT_MODEL_PATH=models/trained_model.pkl
ENCODERS_PATH=models/encoders.pkl

# Data Directories
DATASETS_DIR=datasets
REPORTS_DIR=reports/generated_reports
